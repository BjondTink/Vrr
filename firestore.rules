rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin(data) {
      return (isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.get('email', '').lower() == 'reniqahi2015@gmail.com') ||
        (request.auth.token.get('email', '').lower() == 'admin@vrr.com') ||
        (request.auth.token.get('email', '').lower() == 'admin@valentinavrr.com')
      )) || (data != null && data.get('adminPasscode', '') == 'valentinavrr02');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- Validation Helpers ---
    
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'image', 'category']) &&
             data.name is string &&
             data.price is string &&
             data.image is string &&
             (data.get('gallery', []) is list) &&
             (data.get('sizes', []) is list) &&
             data.category is string;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug']) &&
             data.name is string && data.name.size() <= 50 &&
             data.slug is string && data.slug.size() <= 50;
    }

    function isValidJournalPost(data) {
      return data.keys().hasAll(['title', 'date', 'category', 'image']) &&
             data.title is string && data.title.size() <= 600;
    }

    function isValidOrder(data) {
       return data.keys().hasAll(['customerEmail', 'items', 'total', 'status']) &&
              data.customerEmail is string &&
              data.items is list &&
              data.total is number &&
              data.status in ['pending', 'processing', 'completed', 'cancelled'];
    }

    // --- Match Blocks ---

    // 1. Settings (Top priority)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin(incoming()) || isAdmin(existing());
    }

    match /test/connection {
      allow read: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin(incoming()) && isValidProduct(incoming()) && isValidId(productId);
      allow update: if (isAdmin(incoming()) || isAdmin(existing())) && isValidProduct(incoming());
      allow delete: if isAdmin(existing());
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isAdmin(incoming()) && isValidId(collectionId);
      allow update: if isAdmin(incoming()) || isAdmin(existing());
      allow delete: if isAdmin(existing());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin(incoming()) && isValidCategory(incoming()) && isValidId(categoryId);
      allow update: if (isAdmin(incoming()) || isAdmin(existing())) && isValidCategory(incoming());
      allow delete: if isAdmin(existing());
    }

    match /journalPosts/{postId} {
      allow read: if true;
      allow create: if isAdmin(incoming()) && isValidJournalPost(incoming()) && isValidId(postId);
      allow update: if (isAdmin(incoming()) || isAdmin(existing())) && isValidJournalPost(incoming());
      allow delete: if isAdmin(existing());
    }

    match /orders/{orderId} {
      allow read: if isAdmin(incoming()) || isAdmin(existing()) || (isSignedIn() && existing().get('userId', '') == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isValidOrder(incoming());
      allow update: if isAdmin(incoming()) || isAdmin(existing());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow create: if isSignedIn() && request.auth.uid == adminId && 
                      (request.auth.token.get('email', '').lower() in ['reniqahi2015@gmail.com', 'admin@vrr.com', 'admin@valentinavrr.com']);
    }

    // Global Deny Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
