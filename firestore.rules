rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'reniqahi2015@gmail.com' ||
        request.auth.token.email == 'Reniqahi2015@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---
    
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'image', 'category']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is string && data.price.size() <= 20 &&
             data.image is string && data.image.size() <= 500 &&
             (data.get('gallery', []) is list) &&
             (data.get('sizes', []) is list) &&
             data.category is string && data.category.size() <= 64;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug']) &&
             data.name is string && data.name.size() <= 50 &&
             data.slug is string && data.slug.size() <= 50;
    }

    function isValidJournalPost(data) {
      return data.keys().hasAll(['title', 'date', 'category', 'image']) &&
             data.title is string && data.title.size() <= 600;
    }

    function isValidOrder(data) {
       return data.keys().hasAll(['customerEmail', 'items', 'total', 'status', 'createdAt']) &&
              data.customerEmail is string &&
              data.items is list &&
              data.total is number &&
              data.status in ['pending', 'processing', 'completed', 'cancelled'] &&
              data.createdAt == request.time;
    }

    // --- Match Blocks ---

    // 1. Settings (Top priority)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(incoming()) && isValidId(categoryId);
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    match /journalPosts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidJournalPost(incoming()) && isValidId(postId);
      allow update: if isAdmin() && isValidJournalPost(incoming());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Global Deny Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
