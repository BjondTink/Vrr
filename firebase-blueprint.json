{
  "entities": {
    "product": {
      "title": "Product",
      "description": "A collection piece in the studio",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "string" },
        "discountPrice": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "description": { "type": "string" },
        "details": { "type": "string" },
        "modelInfo": { "type": "string" },
        "slug": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "image"]
    },
    "category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "customerEmail": { "type": "string" },
        "total": { "type": "number" },
        "items": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "journalPost": {
      "title": "Journal Post",
      "description": "A blog or news entry",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "settings": {
      "title": "Global Settings",
      "description": "App-wide configuration",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImage": { "type": "string" },
        "philosophyTag": { "type": "string" },
        "philosophyQuote": { "type": "string" },
        "marqueeText": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "product",
      "description": "Store products"
    },
    "/categories/{categoryId}": {
      "schema": "category",
      "description": "Store categories"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Store customer orders"
    },
    "/journalPosts/{postId}": {
      "schema": "journalPost",
      "description": "Store journal entries"
    },
    "/settings/global": {
      "schema": "settings",
      "description": "Store site global settings"
    }
  }
}
